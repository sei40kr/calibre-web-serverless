{
	"hosting": {
		"public": "web/out",
		"cleanUrls": true,
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"rewrites": [
			{
				"source": "/opds",
				"function": "opds"
			},
			{
				"source": "/opds/**",
				"function": "opds"
			},
			{
				"regex": "^/dashboard/books/[^/]+/edit/?$",
				"destination": "/dashboard/books/__shell__/edit.html"
			}
		]
	},
	"firestore": {
		"database": "(default)",
		"location": "us-west1",
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"storage": {
		"rules": "storage.rules"
	},
	"functions": {
		"source": "functions",
		"runtime": "nodejs22"
	},
	"emulators": {
		"hosting": {
			"port": 5000
		},
		"auth": {
			"port": 9099
		},
		"firestore": {
			"port": 8080
		},
		"storage": {
			"port": 9199
		},
		"functions": {
			"port": 5001
		},
		"eventarc": {
			"port": 9299
		},
		"ui": {
			"enabled": true
		},
		"singleProjectMode": true
	}
}
