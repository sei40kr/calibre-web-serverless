rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A user's whole subtree, matched recursively rather than collection by
    // collection so that adding a collection cannot leave it unreachable.
    //
    // No field validation, deliberately: every path here is scoped to a single
    // owner, so a forged or malformed write — a book marked ready with no file,
    // an updatedAt far enough ahead to hide a stub from the reconcile job — can
    // only corrupt the writer's own library. Checking the payload would restate
    // every document shape in a second language, with nothing keeping the two
    // in sync.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Collection group queries are not covered by the match above: they are
    // evaluated against `match /{path=**}/books/{bookId}`, which nothing here
    // provides, so they are denied. The COLLECTION_GROUP indexes exist for the
    // admin SDK, which bypasses rules. Such a rule could not be written today
    // anyway: a book's owner is in its path, not in a field.
  }
}
