{
	"name": "calibre-web-serverless",
	"private": true,
	"workspaces": [
		"domain",
		"infrastructure",
		"web"
	],
	"scripts": {
		"dev": "bun --filter @calibre-web-serverless/web run dev",
		"build": "bun --filter @calibre-web-serverless/web run build",
		"test": "vitest",
		"test:e2e": "bun --filter @calibre-web-serverless/web run test:e2e",
		"lint": "biome check",
		"format": "biome format --write",
		"storybook": "bun --filter @calibre-web-serverless/web run storybook"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"typescript": "^5",
		"vitest": "^4.0.17"
	}
}
