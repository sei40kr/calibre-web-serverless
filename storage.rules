rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The format list must stay in sync with the domain's book formats.
    function isBookFileUpload(fileName) {
      return fileName.matches('book\\.(epub|pdf|mobi|azw|azw3|fb2|txt)')
        && request.resource.size < 100 * 1024 * 1024;
    }

    // The cap and the image types mirror the domain's cover constants, which
    // the upload form and resizeBookCover check against as well.
    function isCoverUpload(fileName) {
      return fileName.matches('cover_upload\\.(png|jpg|webp)')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
    }

    match /users/{userId}/books/{bookId}/{fileName} {
      allow read: if isOwner(userId);

      // The served covers (cover.png, custom_cover.png) are written by Cloud
      // Functions through the admin SDK, which bypasses these rules, so a
      // client write to those names could only be an attempt to place
      // unresized, arbitrarily typed bytes where a cover is served from.
      allow create, update: if isOwner(userId)
        && (isBookFileUpload(fileName) || isCoverUpload(fileName));

      // Deletes are not name-restricted: removing a book deletes its covers
      // too, and resetting a custom cover deletes custom_cover.png.
      allow delete: if isOwner(userId);
    }
  }
}
