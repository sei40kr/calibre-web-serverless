{
	"name": "@calibre-web-serverless/web",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "bun run --cwd=../functions build && firebase emulators:exec --project=demo-project --ui --only hosting,auth,firestore,storage,functions,eventarc 'bun scripts/seed.ts && next dev --webpack'",
		"build": "NODE_ENV=production next build --webpack",
		"typecheck": "tsgo -p tsconfig.json",
		"test": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@calibre-web-serverless/domain": "workspace:*",
		"@calibre-web-serverless/infrastructure": "workspace:*",
		"@chakra-ui/react": "^3.31.0",
		"@emotion/react": "^11.14.0",
		"next": "16.1.3",
		"next-themes": "^0.4.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.71.1",
		"react-icons": "^5.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@storybook/addon-a11y": "^10.2.0",
		"@storybook/addon-docs": "^10.2.0",
		"@storybook/addon-vitest": "^10.2.0",
		"@storybook/nextjs-vite": "^10.2.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5.1.2",
		"@vitest/browser-playwright": "4.0.17",
		"@vitest/coverage-v8": "4.0.17",
		"babel-plugin-react-compiler": "1.0.0",
		"dotenv": "^17.2.3",
		"firebase-admin": "^13.6.0",
		"firebase-tools": "^15.3.1",
		"jsdom": "^27.4.0",
		"playwright": "^1.57.0",
		"sharp": "^0.34.1",
		"storybook": "^10.2.0",
		"vite-tsconfig-paths": "^6.0.4"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
